{
  "manifest_version": 3,
  "name": "Watch Together",
  "version": "0.1.0",
  "description": "Press play on your side, it plays on theirs. Syncs the video on any site with a room.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Watch Together" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
